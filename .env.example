# Driver de dados: "mock" (demonstração offline, padrão) ou "supabase" (backend real)
EXPO_PUBLIC_DATA_DRIVER=mock

# Supabase — só necessário quando EXPO_PUBLIC_DATA_DRIVER=supabase
# Veja SETUP_SUPABASE.md
EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# LiveKit — só necessário para transmissões reais (development build)
# Veja SETUP_LIVEKIT.md
EXPO_PUBLIC_LIVEKIT_URL=wss://SEU-PROJETO.livekit.cloud
# Endpoint que gera tokens (Supabase Edge Function ou servidor próprio)
EXPO_PUBLIC_LIVEKIT_TOKEN_ENDPOINT=

# Cloudflare R2 — onde a mídia NOVA é guardada (egress zero).
# Sem esta variável, vídeo e imagem continuam no Storage da Supabase, que cobra saída.
# A base precisa ser a mesma cadastrada em public.origens_de_midia e em R2_PUBLIC_URL
# nos segredos das Edge Functions. Veja SETUP_R2.md.
EXPO_PUBLIC_MIDIA_URL=

# GIPHY — busca de GIFs na resenha (chave gratuita em https://developers.giphy.com/dashboard/)
# Sem ela o botão de GIF simplesmente não aparece.
EXPO_PUBLIC_GIPHY_KEY=
